# Copy this file, rename the copy to .env.local, and paste in your real values
# from Supabase -> Project Settings -> API.
# Use the anon (public) key here. NEVER the service_role key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=paste-anon-key-here

# Optional, server-only: required for Delete account. Set on the deployment
# server as well. Never prefix it with NEXT_PUBLIC_ or commit a real key.
# SUPABASE_SERVICE_ROLE_KEY=paste-server-only-key-here

# Optional server-only override; backend/resume/.venv is detected automatically.
# RESUME_PYTHON_BIN=/absolute/path/to/python3
