// Matches supabase/migrations 000 + 001 + 002 + 003 exactly.
// Paste into dbdiagram.io to redraw the diagram.

Enum application_status {
  saved
  not_applied
  applied
  interviewing
  offer
  rejected
}

Table companies {
  id bigint [pk, increment]
  name text [not null, unique]
  website text
  ats_type text [note: 'e.g. greenhouse']
  ats_slug text [note: 'company name on that job board, e.g. stripe']
}

Table jobs {
  id bigint [pk, increment]
  company_id bigint [not null]
  title text [not null]
  location text
  url text [not null]
  posted_at date
  description text
  work_mode text [not null, default: 'unknown', note: 'remote, hybrid, in_person, unknown']
  source text [not null, default: 'manual']
  dedupe_hash text [not null, unique, note: 'fingerprint of company + title + location']
  is_open boolean [not null, default: true]
  last_seen_at timestamptz [not null]
  skills_extracted_at timestamptz [note: 'null = skills not extracted yet']
}

Table skills {
  id bigint [pk, increment]
  name text [not null, unique]
  category text [not null, note: 'language, framework, database, cloud, tool, concept']
}

Table job_skills {
  job_id bigint [pk]
  skill_id bigint [pk]
  required boolean [not null, default: true, note: 'false = preferred / nice-to-have']
}

Table profiles {
  id uuid [pk, note: 'Same ID as the Supabase Auth user']
  full_name text
  school text
  grad_year int
  major text
  preferred_location text
  target_roles text
}

Table applications {
  id bigint [pk, increment]
  user_id uuid [not null]
  job_id bigint [not null]
  status application_status [not null, default: 'not_applied']
  updated_at timestamptz [not null]

  indexes {
    (user_id, job_id) [unique]
  }
}

Ref: jobs.company_id > companies.id
Ref: applications.user_id > profiles.id
Ref: applications.job_id > jobs.id
Ref: job_skills.job_id > jobs.id
Ref: job_skills.skill_id > skills.id
